Bootstrap: docker
From: python:{python_version}-slim

%files
    uv.lock /opt/project/uv.lock
    pyproject.toml /opt/project/pyproject.toml

%environment
    export PATH=/opt/venv/bin:$PATH

%post
    mkdir -p /workdir /mnt/runs /mnt/data /mnt/cache/hf
    # git, because uv installs tinyruns from its git repository.
    # APT::Sandbox::User=root, because in a build without root privileges
    # apt's own user cannot write its temporary files.
    apt-get -o APT::Sandbox::User=root update
    apt-get -o APT::Sandbox::User=root install -y --no-install-recommends \
        git ca-certificates
    rm -rf /var/lib/apt/lists/*
    pip install --no-cache-dir uv
    cd /opt/project
    UV_PROJECT_ENVIRONMENT=/opt/venv UV_PYTHON_DOWNLOADS=never UV_LINK_MODE=copy \
        uv sync --frozen --no-install-project --all-groups --no-dev --no-cache
